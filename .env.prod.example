# =============================================================================
# AGOCAR — Production environment overrides
# Copy this file to .env.local on the production server and fill in real values.
# DO NOT commit .env.local to git.
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING

# ── Database ──────────────────────────────────────────────────────────────────
# Update user/password for the production DB account (never use root in prod)
DATABASE_URL="mysql://agocar_user:STRONG_PASSWORD@127.0.0.1:3306/agocar?serverVersion=10.4.32-MariaDB&charset=utf8mb4"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_THIS_TO_YOUR_JWT_PASSPHRASE

# ── CORS ─────────────────────────────────────────────────────────────────────
# Replace yourdomain.com with the actual frontend domain
CORS_ALLOW_ORIGIN='^https://yourdomain\.com$'

# ── Mailer ────────────────────────────────────────────────────────────────────
MAILER_DSN=smtp://your_email%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587
MAILER_SENDER=your_email@gmail.com
MAILER_RECIPIENT=your_email@gmail.com

# ── Backup (read by scripts/backup.sh) ───────────────────────────────────────
# These are shell env vars — export them in the cron job or server environment
# BACKUP_DB_HOST=127.0.0.1
# BACKUP_DB_NAME=agocar
# BACKUP_DB_USER=agocar_user
# BACKUP_DB_PASS=STRONG_PASSWORD
# BACKUP_DIR=/var/backups/autoloc
