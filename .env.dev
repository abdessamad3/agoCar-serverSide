# This file is listed in .gitignore but was committed at the project's very
# first commit, before that rule existed -- it previously held a real
# generated secret. Generate your own local value and put it in .env.local
# instead (which IS respected): php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=changeme_generate_a_real_secret
